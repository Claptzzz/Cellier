# Copia este archivo a `.env` y ajusta los valores.
# `.env` está en .gitignore: nunca se versiona.

# --- Base de datos (la consumen docker-compose y el backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cellier
DB_USER=cellier
DB_PASSWORD=cambia-esta-clave
# Tamaño máximo del pool de conexiones (solo perfil prod).
DB_POOL_MAX=10

# --- Backend ---
# Perfil activo: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Nivel de log del paquete com.cellier
LOG_LEVEL_CELLIER=DEBUG
# Volcar el SQL de Hibernate por consola (solo dev)
JPA_SHOW_SQL=false
# Endpoints de actuator expuestos por HTTP
MANAGEMENT_ENDPOINTS=health,info
# Publicar Swagger UI (en prod viene apagado por defecto)
SWAGGER_UI_ENABLED=false
