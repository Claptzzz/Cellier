# Copia este archivo a `.env` y ajusta los valores.
# `.env` está en .gitignore: nunca se versiona.

# --- Base de datos (la consumen docker-compose y el backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cellier
DB_USER=cellier
DB_PASSWORD=cambia-esta-clave
# Tamaño máximo del pool de conexiones (solo perfil prod).
DB_POOL_MAX=10

# --- Autenticacion con Google ---
# Client id de OAuth 2.0 (tipo "aplicacion web") de la consola de Google Cloud.
# El backend exige este valor como `aud` de cada ID token, asi que debe ser el mismo
# que usa el frontend al inicializar Google Identity Services.
GOOGLE_CLIENT_ID=123456789012-ejemplo.apps.googleusercontent.com

# Clave HMAC con la que se firman los access token. MINIMO 32 bytes.
# Genera una propia con:  openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-bytes
# Valor del claim `iss` de los tokens que emite Cellier.
JWT_ISSUER=https://cellier.app

# --- Backend ---
# Perfil activo: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Nivel de log del paquete com.cellier
LOG_LEVEL_CELLIER=DEBUG
# Volcar el SQL de Hibernate por consola (solo dev)
JPA_SHOW_SQL=false
# Endpoints de actuator expuestos por HTTP
MANAGEMENT_ENDPOINTS=health,info
# Publicar Swagger UI (en prod viene apagado por defecto)
SWAGGER_UI_ENABLED=false
