# --- Java / Maven ---
target/
*.jar
*.war
*.class
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- Node / Angular ---
node_modules/
# Toolchain de Node que instala frontend-maven-plugin en el perfil `frontend`
backend/.frontend-toolchain/
dist/
.angular/
npm-debug.log*
yarn-error.log*

# --- Entorno ---
.env
# Generados por frontend/scripts/sync-environment.mjs desde el .env de la raiz.
# Llevan el client id real de Google, asi que no se versionan.
frontend/src/environments/environment.development.ts
frontend/src/environments/environment.prod.ts
.env.local
*.local

# --- IDEs ---
.idea/
# `.vscode/` a secas excluia el DIRECTORIO, y git no desciende a un directorio excluido:
# eso anulaba en silencio las negaciones de frontend/.gitignore, que si querian versionar
# la configuracion compartida del editor. Se ignora el CONTENIDO para que las negaciones
# de abajo puedan aplicarse.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.iml
*.ipr
*.iws
.settings/
.project
.classpath
nbproject/private/

# --- SO ---
.DS_Store
Thumbs.db

# --- Logs / temporales ---
*.log
logs/
*.pid

# La documentacion del proyecto SI se versiona: ADRs, reglas de dominio, sistema de
# diseno y las dos guias del arnes son buena parte de lo que este repositorio entrega
# como memoria. Estuvieron fuera ocho incrementos por esta linea.
# Lo que no va son las capturas del arnes: 206 ficheros y 24 MB regenerados en cada pasada.
# Son salida, no documentacion.
docs/ui-shots/

# Skills de Claude de terceros, traidas de fuera. No son trabajo del proyecto.
.claude/skills/